#
# PAM policy for ChatServer (jabberd2): pamauth(8) checks XMPP sign-ins
# against it, as Apple's ChatServer checked them against Open Directory.
#

# auth
auth		required	pam_unix.so		no_warn try_first_pass

# account
account		required	pam_nologin.so
account		required	pam_unix.so

# Only the members of the chat group may sign in, as with Apple's chat
# service access list (SACL). "make install" creates the group, empty; add
# users with "pw groupmod chat -m user". An empty or missing group lets
# nobody in. Whatever this file says, pamauth(8) refuses root and the
# system accounts (uids below 1000).
account		required	pam_group.so		luser group=chat
